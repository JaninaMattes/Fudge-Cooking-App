# Lombok writes the access methods, equals, hashCode and toString of the model
# classes. This file tells Lombok to mark that code with @lombok.Generated.
#
# JaCoCo then leaves the generated code out of the coverage report, so the
# report measures the code of the application only. Without this setting, the
# report shows the many null checks of the generated equals methods as code
# that no test reaches.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
