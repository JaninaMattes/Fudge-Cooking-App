<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of a large card. The design uses no border. The round corners
    and the white surface are enough, and the content gets more room.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface_card" />
    <corners android:radius="@dimen/radius_large" />
</shape>
