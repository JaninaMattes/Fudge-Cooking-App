<?xml version="1.0" encoding="utf-8"?>
<!--
    Themes for the dark mode.

    The styles keep the same names and the same structure as in values/.
    Only the values that the dark mode needs are here. All colours come from
    values-night/colors.xml, so this file stays short.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Fudge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/sage_500</item>
        <item name="colorOnSecondary">@color/on_brand_secondary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/feedback_danger</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_disabled</item>

        <!-- System bars. A dark screen needs light icons in the status bar. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface_navigation</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Shape and type -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Fudge.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Fudge.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Fudge.Large</item>
        <item name="android:fontFamily">@font/lato_regular</item>

        <!-- Default style of the components -->
        <item name="materialButtonStyle">@style/Widget.Fudge.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Fudge.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Fudge.BottomNavigation</item>
    </style>

    <style name="Theme.FeedMe" parent="Theme.Fudge">
        <item name="android:windowBackground">@drawable/bg_gradient_night</item>
    </style>

    <style name="SplashTheme" parent="Theme.Fudge">
        <item name="android:windowBackground">@drawable/splash_background_night</item>
        <item name="android:statusBarColor">@color/surface_background</item>
    </style>

    <style name="LoginTheme" parent="Theme.Fudge">
        <item name="android:windowBackground">@drawable/bg_gradient_night</item>
        <item name="android:statusBarColor">@color/surface_background</item>
    </style>

</resources>
