<?xml version="1.0" encoding="utf-8"?>
<!--
    Colours of the Fudge design system.

    The colours come from the design in frontend/doc/design/ui_design_ideas_002.png:
    a white screen, an emerald green accent, near-black text and grey helper
    text. The picture is the first thing that the user sees, so the interface
    around it stays quiet and uses colour only where colour carries a meaning.

    The file has three parts:

    1. The palette. The raw colours.
    2. The semantic tokens. A layout uses a token, because the name of a token
       says where the colour belongs. A change of the brand then needs one
       change here and no change in the 51 layout files.
    3. The names of the first version. They point to the new tokens, so that
       the old layouts keep working. Do not use them in new code.
-->
<resources>

    <!-- ===================================================================
         1. Palette
         =================================================================== -->

    <!-- Emerald green. The one strong colour of the interface. It marks the
         action that the user can take: the round button, the active tab, the
         link "See all" and the selected category. -->
    <color name="emerald_50">#E8F6ED</color>
    <color name="emerald_100">#C6E9D3</color>
    <color name="emerald_300">#5FC787</color>
    <color name="emerald_500">#16A34A</color>
    <color name="emerald_600">#12833C</color>
    <color name="emerald_700">#0E6830</color>

    <!-- Neutral. The screen, the cards and the text. -->
    <color name="neutral_0">#FFFFFFFF</color>
    <color name="neutral_50">#FAFAFA</color>
    <color name="neutral_100">#F4F5F6</color>
    <color name="neutral_200">#E9EAEC</color>
    <color name="neutral_300">#DCDEE1</color>
    <color name="neutral_400">#B5B9BE</color>
    <color name="neutral_500">#8E9399</color>
    <color name="neutral_600">#6B7076</color>
    <color name="neutral_700">#4A4F55</color>
    <color name="neutral_800">#2A2E33</color>
    <color name="neutral_900">#15181B</color>
    <color name="neutral_1000">#FF000000</color>

    <!-- Amber. The stars of a rating only. -->
    <color name="amber_400">#FFC94D</color>
    <color name="amber_500">#FFB800</color>

    <!-- Status colours. The user reads the state of the food from them. -->
    <color name="status_fresh">#16A34A</color>
    <color name="status_soon">#E8A020</color>
    <color name="status_urgent">#F06A28</color>
    <color name="status_expired">#E02B2B</color>

    <!-- A dark layer over a picture. The white text on a photo must stay
         readable, also on a bright photo. -->
    <color name="scrim_strong">#B315181B</color>
    <color name="scrim_soft">#5915181B</color>

    <!-- ===================================================================
         2. Semantic tokens. New code uses these names.
         =================================================================== -->

    <!-- Brand -->
    <color name="brand_primary">@color/emerald_500</color>
    <color name="brand_primary_dark">@color/emerald_700</color>
    <color name="brand_primary_light">@color/emerald_100</color>
    <color name="brand_secondary">@color/neutral_900</color>
    <color name="brand_accent">@color/emerald_500</color>
    <color name="on_brand_primary">@color/neutral_0</color>
    <color name="on_brand_secondary">@color/neutral_0</color>
    <color name="on_brand_accent">@color/neutral_0</color>

    <!-- Surfaces -->
    <color name="surface_background">@color/neutral_0</color>
    <color name="surface_card">@color/neutral_0</color>
    <color name="surface_card_muted">@color/neutral_100</color>
    <color name="surface_card_strong">@color/neutral_900</color>
    <color name="surface_input">@color/neutral_100</color>
    <color name="surface_divider">@color/neutral_200</color>
    <color name="surface_navigation">@color/neutral_0</color>
    <color name="surface_overlay">@color/scrim_strong</color>

    <!-- Text and icons -->
    <color name="text_primary">@color/neutral_900</color>
    <color name="text_secondary">@color/neutral_500</color>
    <color name="text_disabled">@color/neutral_400</color>
    <color name="text_on_dark">@color/neutral_0</color>
    <color name="text_on_dark_secondary">@color/neutral_200</color>
    <color name="text_link">@color/emerald_500</color>
    <color name="icon_primary">@color/neutral_900</color>
    <color name="icon_secondary">@color/neutral_500</color>
    <color name="icon_on_dark">@color/neutral_0</color>
    <color name="icon_active">@color/emerald_500</color>
    <color name="icon_inactive">@color/neutral_400</color>
    <color name="rating_star">@color/amber_500</color>

    <!-- Feedback -->
    <color name="feedback_success">@color/status_fresh</color>
    <color name="feedback_warning">@color/status_soon</color>
    <color name="feedback_danger">@color/status_expired</color>
    <color name="feedback_info">@color/emerald_600</color>

    <!-- ===================================================================
         3. Names of the first version. Do not use them in new code.
         =================================================================== -->

    <color name="colorPrimary">@color/brand_primary</color>
    <color name="colorPrimaryLight">@color/brand_primary_light</color>
    <color name="colorPrimaryDark">@color/brand_primary_dark</color>
    <color name="colorAccent">@color/brand_accent</color>

    <color name="black">@color/text_primary</color>
    <color name="white">@color/neutral_0</color>
    <color name="dark_grey">@color/text_secondary</color>
    <color name="light_grey">@color/neutral_400</color>
    <color name="bright_grey">@color/neutral_50</color>
    <color name="bright_grey_200">@color/neutral_200</color>

    <color name="red_200">@color/brand_primary</color>
    <color name="bright_red_200">@color/feedback_danger</color>
    <color name="theme_red_100">@color/feedback_danger</color>
    <color name="salmon_red">@color/status_urgent</color>
    <color name="theme_orange_100">@color/feedback_warning</color>

    <color name="green_200">@color/emerald_100</color>
    <color name="green_500">@color/emerald_500</color>
    <color name="green_700">@color/emerald_700</color>
    <color name="bright_green_200">@color/emerald_300</color>

    <color name="theme_creme_100">@color/neutral_100</color>
    <color name="theme_creme_50">@color/neutral_50</color>
    <color name="theme_creme_dark">@color/neutral_200</color>
    <color name="theme_creme_500">@color/neutral_100</color>

    <color name="blue_700">@color/feedback_info</color>
    <color name="theme_dark_blue_100">@color/neutral_900</color>

    <!-- ===================================================================
         Colours of the ZXing barcode reader
         =================================================================== -->

    <color name="zxing_viewfinder_laser">@color/brand_primary</color>
    <color name="zxing_possible_result_points">@color/brand_primary</color>
    <color name="zxing_result_view">@color/neutral_900</color>
    <color name="zxing_status_text">@color/text_on_dark</color>
    <color name="zxing_transparent">@color/neutral_1000</color>
    <color name="zxing_viewfinder_mask">@color/scrim_strong</color>

</resources>
