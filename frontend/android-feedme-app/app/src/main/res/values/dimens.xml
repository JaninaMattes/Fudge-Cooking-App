<?xml version="1.0" encoding="utf-8"?>
<!--
    Sizes of the Fudge design system.

    All distances come from one scale with a step of 4dp. A layout that uses
    the scale looks calm, because each distance is a multiple of the same
    value. The Material Design guidelines recommend this method.

    The names of the first version stay at the end of the file and point to the
    scale. Do not use them in new code.
-->
<resources>

    <!-- ===================================================================
         Space. Step of 4dp.
         =================================================================== -->
    <dimen name="space_1">4dp</dimen>
    <dimen name="space_2">8dp</dimen>
    <dimen name="space_3">12dp</dimen>
    <dimen name="space_4">16dp</dimen>
    <dimen name="space_5">20dp</dimen>
    <dimen name="space_6">24dp</dimen>
    <dimen name="space_8">32dp</dimen>
    <dimen name="space_10">40dp</dimen>
    <dimen name="space_12">48dp</dimen>
    <dimen name="space_16">64dp</dimen>

    <!-- Distance between the content and the edge of the screen. -->
    <dimen name="screen_margin_horizontal">16dp</dimen>
    <dimen name="screen_margin_vertical">16dp</dimen>

    <!-- ===================================================================
         Type scale
         =================================================================== -->
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_body_small">14sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_title_small">18sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_headline">24sp</dimen>
    <dimen name="text_display">30sp</dimen>

    <!-- ===================================================================
         Shape. A round corner makes a card friendly and easy to read.
         =================================================================== -->
    <dimen name="radius_small">8dp</dimen>
    <dimen name="radius_medium">16dp</dimen>
    <dimen name="radius_large">20dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- ===================================================================
         Height. A control that a finger touches needs 48dp.
         See the accessibility guidelines of Android.
         =================================================================== -->
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="button_height">48dp</dimen>
    <dimen name="bottom_navigation_height">64dp</dimen>
    <dimen name="icon_button_size">40dp</dimen>
    <dimen name="chip_height">40dp</dimen>
    <dimen name="recipe_card_image_height">180dp</dimen>
    <dimen name="recipe_card_width">160dp</dimen>
    <dimen name="avatar_size">44dp</dimen>
    <dimen name="search_field_height">48dp</dimen>
    <dimen name="product_image_height">155dp</dimen>
    <dimen name="recipe_detail_image_height">137dp</dimen>
    <dimen name="button_export_ingredient">288dp</dimen>
    <dimen name="button_export_ingredient_height">48dp</dimen>

    <!-- ===================================================================
         Elevation. A card lifts only a little, so that the screen stays calm.
         =================================================================== -->
    <dimen name="elevation_flat">0dp</dimen>
    <dimen name="elevation_raised">2dp</dimen>
    <dimen name="elevation_floating">6dp</dimen>
    <dimen name="elevation_overlay">12dp</dimen>

    <!-- Width of a line -->
    <dimen name="stroke_width">1dp</dimen>
    <dimen name="stroke_width_strong">2dp</dimen>

    <!-- ===================================================================
         Names of the first version. Do not use them in new code.
         =================================================================== -->

    <!-- Margin of a screen -->
    <dimen name="activity_horizontal_margin">@dimen/screen_margin_horizontal</dimen>
    <dimen name="activity_vertical_margin">@dimen/screen_margin_vertical</dimen>
    <dimen name="fragment_horizontal_margin">@dimen/screen_margin_horizontal</dimen>
    <dimen name="fragment_vertical_margin">@dimen/screen_margin_vertical</dimen>

    <!-- Margin of a text -->
    <dimen name="text_margin">@dimen/space_4</dimen>
    <dimen name="super_large_text_margin">@dimen/space_6</dimen>
    <dimen name="extra_large_text_margin">@dimen/space_4</dimen>
    <dimen name="large_text_margin">@dimen/space_3</dimen>
    <dimen name="medium_text_margin">@dimen/space_2</dimen>
    <dimen name="intermediate_text_margin">@dimen/space_2</dimen>
    <dimen name="small_text_margin">@dimen/space_1</dimen>
    <dimen name="tiny_text_margin">@dimen/space_1</dimen>

    <!-- Size of a text -->
    <dimen name="text_xsmall">@dimen/text_caption</dimen>
    <dimen name="text_small">@dimen/text_body_small</dimen>
    <dimen name="text_medium">@dimen/text_body</dimen>
    <dimen name="text_large">@dimen/text_title</dimen>
    <dimen name="text_extra_large">@dimen/text_headline</dimen>
    <dimen name="text_extreme_large">@dimen/text_display</dimen>
    <dimen name="small_text_dim">@dimen/text_caption</dimen>
    <dimen name="medium_text_dim">@dimen/text_body_small</dimen>

    <!-- Margin of a button -->
    <dimen name="extreme_btn_margin">@dimen/space_6</dimen>
    <dimen name="large_btn_margin">@dimen/space_3</dimen>
    <dimen name="medium_btn_margin">@dimen/space_2</dimen>
    <dimen name="small_btn_margin">@dimen/space_1</dimen>
    <dimen name="tiny_btn_margin">@dimen/space_1</dimen>
    <dimen name="button_text_elevation">@dimen/space_4</dimen>
    <dimen name="super_large_button_margin">@dimen/space_5</dimen>
    <dimen name="super_duper_large_button_margin">@dimen/space_8</dimen>
    <dimen name="large_switch_button_margin">@dimen/space_6</dimen>
    <dimen name="super_duper_large_switch_button_margine">96dp</dimen>
    <dimen name="super_duper_large_switch_button_margin">112dp</dimen>

    <!-- Card -->
    <dimen name="tiny_card_elevation">@dimen/elevation_raised</dimen>
    <dimen name="small_card_elevation">@dimen/elevation_raised</dimen>
    <dimen name="medium_card_elevation">@dimen/elevation_floating</dimen>
    <dimen name="large_card_elevation">@dimen/elevation_floating</dimen>
    <dimen name="card_view_corner_radius">@dimen/radius_large</dimen>
    <dimen name="large_cardview_margin">@dimen/space_3</dimen>
    <dimen name="medium_cardview_margin">@dimen/space_2</dimen>
    <dimen name="small_cardview_margin">@dimen/space_1</dimen>
    <dimen name="tiny_cardview_margin">@dimen/space_1</dimen>
    <dimen name="large_cardview_padding">@dimen/space_4</dimen>
    <dimen name="medium_cardview_padding">@dimen/space_2</dimen>
    <dimen name="small_cardview_padding">@dimen/space_1</dimen>
    <dimen name="tiny_cardview_padding">@dimen/space_1</dimen>

    <!-- List -->
    <dimen name="large_recview_margin">@dimen/space_3</dimen>
    <dimen name="medium_recview_margin">@dimen/space_2</dimen>
    <dimen name="small_recview_margin">@dimen/space_1</dimen>
    <dimen name="tiny_recview_margin">@dimen/space_1</dimen>

    <!-- Margin of the progress bar -->
    <dimen name="extreme_margin">@dimen/space_16</dimen>
    <dimen name="large_margin">@dimen/space_8</dimen>

</resources>
