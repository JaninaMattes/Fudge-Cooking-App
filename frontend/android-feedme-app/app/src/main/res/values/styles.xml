<?xml version="1.0" encoding="utf-8"?>
<!--
    Components and text styles of the Fudge design system.

    The styles follow the design in frontend/doc/design/ui_design_ideas_002.png:
    a white screen, large pictures with round corners, a grey search field,
    and one emerald green colour for each action.

    A layout uses a style and does not write the colour, the size and the
    distance again for each view. The screens then look equal, and a change
    needs one change in this file.
-->
<resources>

    <!-- ===================================================================
         Text. Each style has one clear task.
         =================================================================== -->

    <!-- The question on the start screen: "What would you like to cook
         today?". It is the largest text of the application. -->
    <style name="TextAppearance.Fudge.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- The title of a screen, for example "Bookmark". -->
    <style name="TextAppearance.Fudge.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- The title of a section, for example "Recommendation". -->
    <style name="TextAppearance.Fudge.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- The name of a recipe or of a product under a picture. -->
    <style name="TextAppearance.Fudge.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- A normal text. -->
    <style name="TextAppearance.Fudge.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- The grey text under a name, for example "By David Charles". -->
    <style name="TextAppearance.Fudge.BodySecondary" parent="TextAppearance.Fudge.Body">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- A short value, for example "10 mins" or "512 cal". -->
    <style name="TextAppearance.Fudge.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- The link "See all" at the end of the title of a section. -->
    <style name="TextAppearance.Fudge.Link" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_link</item>
    </style>

    <!-- A text on a picture or on a dark card. -->
    <style name="TextAppearance.Fudge.OnDark" parent="TextAppearance.Fudge.Body">
        <item name="android:textColor">@color/text_on_dark</item>
    </style>

    <!-- ===================================================================
         Buttons
         =================================================================== -->

    <!-- The main action of a screen, for example "Login". -->
    <style name="Widget.Fudge.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/space_6</item>
        <item name="android:paddingEnd">@dimen/space_6</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/on_brand_primary</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">@dimen/elevation_flat</item>
        <item name="rippleColor">@color/emerald_100</item>
    </style>

    <!-- A second action that is not the main action. -->
    <style name="Widget.Fudge.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/surface_divider</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="rippleColor">@color/neutral_100</item>
    </style>

    <!-- An action that needs no border, for example "Forgot the password?". -->
    <style name="Widget.Fudge.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/text_link</item>
    </style>

    <!-- An action that deletes something. The colour warns the user. -->
    <style name="Widget.Fudge.Button.Danger" parent="Widget.Fudge.Button">
        <item name="backgroundTint">@color/feedback_danger</item>
        <item name="android:textColor">@color/neutral_0</item>
    </style>

    <!-- The round green button in the middle of the navigation bar. It adds
         a product or a recipe. -->
    <style name="Widget.Fudge.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="tint">@color/on_brand_primary</item>
        <item name="elevation">@dimen/elevation_floating</item>
        <item name="borderWidth">0dp</item>
        <item name="fabSize">normal</item>
    </style>

    <!-- A small round button over a picture, for example the bookmark. -->
    <style name="Widget.Fudge.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">@dimen/space_2</item>
        <item name="backgroundTint">@color/surface_card</item>
        <item name="iconTint">@color/icon_primary</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">@dimen/elevation_raised</item>
    </style>

    <!-- ===================================================================
         Cards
         =================================================================== -->

    <!-- A card with a picture, as the design uses it for a recipe. The card
         has no border and almost no shadow, so the picture carries the
         screen. -->
    <style name="Widget.Fudge.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/elevation_flat</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="contentPadding">0dp</item>
        <item name="android:layout_margin">@dimen/space_1</item>
    </style>

    <!-- A card that lifts from the screen, for example a dialog or the sheet
         of the details of a recipe. -->
    <style name="Widget.Fudge.Card.Raised" parent="Widget.Fudge.Card">
        <item name="cardElevation">@dimen/elevation_raised</item>
        <item name="contentPadding">@dimen/space_4</item>
    </style>

    <!-- A card with a grey background, for a group of values. -->
    <style name="Widget.Fudge.Card.Muted" parent="Widget.Fudge.Card">
        <item name="cardBackgroundColor">@color/surface_card_muted</item>
        <item name="contentPadding">@dimen/space_4</item>
    </style>

    <!-- A dark card over a picture, for example "10 Recipes". -->
    <style name="Widget.Fudge.Card.Strong" parent="Widget.Fudge.Card">
        <item name="cardBackgroundColor">@color/surface_card_strong</item>
    </style>

    <!-- ===================================================================
         Other components
         =================================================================== -->

    <!-- The navigation bar at the bottom. It is white and lifts from the
         screen, as the design shows. -->
    <style name="Widget.Fudge.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/custom_navbar_background</item>
        <item name="itemIconTint">@drawable/custom_navbar_selector</item>
        <item name="itemTextColor">@drawable/custom_navbar_selector</item>
        <item name="itemRippleColor">@color/emerald_50</item>
        <item name="android:minHeight">@dimen/bottom_navigation_height</item>
        <item name="elevation">@dimen/elevation_floating</item>
        <item name="labelVisibilityMode">unlabeled</item>
    </style>

    <!-- The grey search field at the top of a list. -->
    <style name="Widget.Fudge.SearchField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- A field in which the user writes, for example the email address. -->
    <style name="Widget.Fudge.TextInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_medium</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="errorTextColor">@color/feedback_danger</item>
    </style>

    <!-- A category, for example "Breakfast". The selected category is green
         with white text, as the design shows. -->
    <style name="Widget.Fudge.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@drawable/chip_background_selector</item>
        <item name="android:textColor">@drawable/chip_text_selector</item>
        <item name="chipCornerRadius">@dimen/radius_medium</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- A line between two items of a list. -->
    <style name="Widget.Fudge.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_width</item>
        <item name="android:background">@color/surface_divider</item>
    </style>

    <!-- The stars of a rating. -->
    <style name="Widget.Fudge.RatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:progressTint">@color/rating_star</item>
        <item name="android:secondaryProgressTint">@color/surface_divider</item>
        <item name="android:progressBackgroundTint">@color/surface_divider</item>
    </style>

</resources>
