<?xml version="1.0" encoding="utf-8"?>
<!--
    Themes of the Fudge application.

    A theme gives each screen the same colours. A view that sets no colour
    reads the colour from the theme, so a change of the brand needs a change
    in this file only.

    The colours follow frontend/doc/design/ui_design_ideas_002.png: a white
    screen, near-black text and one emerald green for each action. The file
    values-night holds the values for the dark mode.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================
         Base theme. All other themes start from it.
         =================================================================== -->
    <style name="Theme.Fudge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/on_brand_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/feedback_danger</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- System bars. The screen is white, so the status bar needs dark
             icons. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface_background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Shape and type -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Fudge.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Fudge.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Fudge.Large</item>
        <item name="android:fontFamily">@font/lato_regular</item>

        <!-- Default style of the components -->
        <item name="materialButtonStyle">@style/Widget.Fudge.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Fudge.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Fudge.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Widget.Fudge.Fab</item>
        <item name="chipStyle">@style/Widget.Fudge.Chip</item>
    </style>

    <!--
        Name of the first version. The manifest and the activities use it.
        It gives the new theme, so that the application keeps one look.
    -->
    <style name="Theme.FeedMe" parent="Theme.Fudge">
        <item name="android:windowBackground">@color/surface_background</item>
    </style>

    <!-- Screen of the start. It shows the logo on the white surface. -->
    <style name="SplashTheme" parent="Theme.Fudge">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Screens of the login and of the registration -->
    <style name="LoginTheme" parent="Theme.Fudge">
        <item name="android:windowBackground">@color/surface_background</item>
    </style>

    <!-- ===================================================================
         Shape
         =================================================================== -->
    <style name="ShapeAppearance.Fudge.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.Fudge.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeAppearance.Fudge.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <!-- ===================================================================
         Dialog of the date picker
         =================================================================== -->
    <style name="DialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DatePickerPosButtonTheme</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DatePickerNegButtonTheme</item>
    </style>

    <style name="DatePickerPosButtonTheme" parent="Base.Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="DatePickerNegButtonTheme" parent="Base.Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===================================================================
         Names of the first version. They point to the new styles.
         =================================================================== -->
    <style name="ButtonTheme" parent="Widget.Fudge.Button" />

    <style name="unimportantButtonTheme" parent="Widget.Fudge.Button.Secondary" />

    <style name="ExportButtonTheme" parent="Widget.Fudge.Button">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="iconSize">@dimen/text_body_small</item>
    </style>

    <style name="ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_marginTop">@dimen/space_16</item>
        <item name="android:layout_marginBottom">@dimen/space_16</item>
        <item name="android:layout_marginStart">@dimen/space_8</item>
        <item name="android:layout_marginEnd">@dimen/space_8</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:indeterminateTint">@color/brand_primary</item>
    </style>

</resources>
